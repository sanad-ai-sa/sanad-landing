rules_version = '2';
// قواعد حماية بيانات مشتركي سَنَد — هذي اللي تمنع التجاوز فعلياً (مو كود الصفحة).
// • المشترك يقرأ ملفه هو فقط، وبعد ما يكون بريده مؤكد (أو دخل بقوقل).
// • يقدر يسجّل الباقة اللي اختارها (plan / intent) بس — ما يقدر يفعّل نفسه.
// • لوحة المشترك (merchants/{uid}) ما يكتب فيها إلا سند من الخادم (Admin SDK يتجاوز القواعد).
// • التقارير والحركة اليومية تنقرأ فقط إذا الاشتراك مفعّل (active == true).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() {
      return signedIn() && (request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'google.com'
        || (request.auth.token.firebase.sign_in_provider == 'facebook.com'
            && request.auth.token.email is string));
    }
    function isOwner(uid) { return verified() && request.auth.uid == uid; }
    function validChoice(d) {
      return d.plan in ['stores', 'social'] && d.intent in ['trial', 'subscribe'];
    }

    // ملف الزائر: ينشئه مرة وحدة بحقول محددة، وبعدها يقدر يحدّث اختيار الباقة فقط.
    match /profiles/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'provider', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.provider is string && request.resource.data.provider.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'intent', 'chosenAt'])
        && validChoice(request.resource.data)
        && request.resource.data.chosenAt == request.time;
      allow delete: if false;
    }

    // بيانات المشترك: قراءة فقط لصاحبها، والكتابة من الخادم فقط.
    match /merchants/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /{sub=**} {
        allow read: if isOwner(uid)
          && get(/databases/$(database)/documents/merchants/$(uid)).data.active == true;
        allow write: if false;
      }
    }

    // أي شي ثاني ممنوع.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
